<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CMS</title>
    <link rel="stylesheet" href="~/Assets/CSS/output.css" />
    @RenderSection("Styles", required: false)
</head>

<body class="bg-white text-black font-sans">
    <header class="relative flex items-center justify-center h-[400px]">
        <div class="grid w-full px-4 place-items-stretch">
            <div class="container mx-auto px-4 text-center">
                <img src="data:image/jpeg;base64," alt="Hero image of a cat" class="w-full h-full object-cover max-h-[400px]" />
                <h1 class="absolute top-1/3 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white text-4xl font-bold drop-shadow-lg text-center">
                    Welcome to the Cat Lovers' Hub!
                </h1>
            </div>
           
        </div>
        
    </header>
    <div class="max-w-4xl mx-auto px-4 py-8">
        @RenderBody()
        @RenderSection("Scripts", required: false)
    </div>
    <footer class="flex justify-center bg-gray-100 text-gray-600 text-center py-4 mt-8 shadow-inner">
        
        <div class="px-4">About</div>
        <div class="px-4">Contact</div>
    </footer>
</body>

</html>
