@using Cms.Models.Pages

@model ArticlesPage
@{
    Layout = "../Base/Base.cshtml";   
}

<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @if (Model.Cards?.Items != null)
    {
        foreach (var item in Model.Cards.Items)
        {
            var card = item.LoadContent() as ArticleCardBlock;
            if (card == null) continue;
            <div onclick="CardModal()" class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
                @if (!string.IsNullOrEmpty(card.ImageUrl))
                {
                    
                    <img src="@card.ImageUrl" alt="Image for @card.Subheading" class="w-full h-48 object-cover transition-transform duration-150 ease-out hover:scale-105 hover:ease-in" />
                    
                }
                <div class="p-4 flex-1 flex flex-col">
                    @if (!string.IsNullOrEmpty(card.Subheading))
                    {
                        <h2 class="text-xl font-semibold mb-2">@card.Subheading</h2>
                    }
                    @if (!string.IsNullOrEmpty(card.MainBody))
                    {
                        <p class="text-gray-700 flex-1">@card.MainBody</p>
                    }
                </div>
            </div>
        }
    }
    
   
</section>
